# =====================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (SEGURO PARA GIT)
# Copia este archivo a '.env' e ingresa tus credenciales reales
# =====================================================================

# Clave de API de Anthropic Claude (Claude Sonnet 5 Vision Engine)
# Consíguela en: https://console.anthropic.com/
ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui

# Modelo por defecto
CLAUDE_MODEL=claude-sonnet-5

# =====================================================================
# CONFIGURACIÓN DE BASE DE DATOS MYSQL (TRAZABILIDAD TOTAL)
# =====================================================================
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=trazabilidad_selloslibros
